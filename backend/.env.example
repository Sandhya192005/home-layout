DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_home_layout
SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Powers the in-app house-Q&A chat assistant (app/services/chat_assistant.py).
# Get a key at https://build.nvidia.com -- leave blank to disable the feature
# (the /chat endpoint returns 503 rather than failing at startup).
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct
